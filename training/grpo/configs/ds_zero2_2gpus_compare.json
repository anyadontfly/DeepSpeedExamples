{
    "bf16": {
        "enabled": true
    },
    "zero_optimization": {
        "stage": 2,
        "overlap_comm": true,
        "contiguous_gradients": true,
        "reduce_bucket_size": 5e8,
        "allgather_bucket_size": 5e8
    },
    "optimizer": {
        "type": "AdamW",
        "params": {
            "lr": 1e-6,
            "betas": [0.9, 0.98],
            "eps": 1e-8,
            "weight_decay": 0.1,
            "torch_adam": true
        }
    },
    "gradient_clipping": 1.0,
    "hybrid_engine": {
        "enabled": true
    },
    "steps_per_print": 1000000,
    "wall_clock_breakdown": false
}
